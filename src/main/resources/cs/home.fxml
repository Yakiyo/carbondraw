<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="30.0" styleClass="root-pane" stylesheets="@home.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cs.HomeController">
    <children>
        <!-- Game Title Section -->
        <VBox alignment="CENTER" spacing="8.0" styleClass="title-box">
            <children>
                <Label styleClass="game-title" text="♠  CARBON DRAW  ♥" />
                <Label styleClass="game-subtitle" text="♦  THE ROGUELIKE DECKBUILDER  ♣" />
            </children>
        </VBox>

        <!-- Menu Buttons Section -->
        <VBox alignment="CENTER" spacing="18.0" styleClass="button-box">
            <children>
                <Button fx:id="playButton" onAction="#handlePlay" styleClass="menu-button, btn-play" text="PLAY" />
                <Button fx:id="settingsButton" onAction="#handleSettings" styleClass="menu-button, btn-settings" text="SETTINGS" />
                <Button fx:id="exitButton" onAction="#handleExit" styleClass="menu-button, btn-exit" text="EXIT" />
            </children>
        </VBox>

        <!-- Dynamic Game Status Feedback -->
        <Label fx:id="statusLabel" styleClass="status-label" text="Ready to deal... Select an option" />

        <!-- Footer / Version -->
        <Label styleClass="footer-label" text="v1.0.0 • BALATRO EDITION" />
    </children>
</VBox>
