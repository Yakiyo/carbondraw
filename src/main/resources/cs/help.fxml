<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<AnchorPane styleClass="root-pane" stylesheets="@home.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cs.HelpController" prefWidth="1920.0" prefHeight="1000.0">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <!-- LEFT NAVIGATION PANEL -->
            <left>
                <VBox styleClass="left-panel" prefWidth="350.0" minWidth="350.0" spacing="30.0" alignment="TOP_CENTER">
                    <VBox alignment="CENTER" spacing="10.0" styleClass="panel-section">
                        <Label styleClass="game-title" style="-fx-font-size: 32px;" text="CARBON DRAW" />
                        <Label text="HELP &amp; GUIDE" styleClass="status-label" style="-fx-font-size: 18px;" />
                    </VBox>

                    <VBox spacing="15.0" alignment="CENTER" styleClass="panel-section">
                        <Button fx:id="mechanicsBtn" onAction="#showMechanics" styleClass="menu-button" style="-fx-pref-width: 250px; -fx-pref-height: 45px; -fx-font-size: 16px; -fx-background-color: #fca311; -fx-text-fill: white;" text="Mechanics" />
                        <Button fx:id="addonsBtn" onAction="#showAddons" styleClass="menu-button" style="-fx-pref-width: 250px; -fx-pref-height: 45px; -fx-font-size: 16px;" text="Addons" />
                    </VBox>

                    <VBox spacing="15.0" alignment="BOTTOM_CENTER" styleClass="panel-section" VBox.vgrow="ALWAYS" style="-fx-padding: 0 0 40 0;">
                        <Button onAction="#handleReturnHome" styleClass="menu-button, btn-exit" text="Back to Menu" style="-fx-pref-width: 250px; -fx-pref-height: 45px; -fx-font-size: 16px;" />
                    </VBox>
                </VBox>
            </left>

            <!-- RIGHT CONTENT AREA -->
            <center>
                <StackPane style="-fx-padding: 50px;">
                    <!-- MECHANICS VIEW -->
                    <VBox fx:id="mechanicsView" alignment="TOP_LEFT" spacing="20.0" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 15px; -fx-padding: 40px;">
                        <Label text="GAME MECHANICS" style="-fx-font-size: 36px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        
                        <VBox spacing="10.0">
                            <Label text="Runs" style="-fx-font-size: 24px; -fx-text-fill: #fca311; -fx-font-weight: bold;"/>
                            <Label text="A full attempt at beating the game, consisting of multiple Antes. If you fail to reach a target score in any round, your run ends." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                        <VBox spacing="10.0">
                            <Label text="Antes" style="-fx-font-size: 24px; -fx-text-fill: #fca311; -fx-font-weight: bold;"/>
                            <Label text="A set level of difficulty with a target score. Beat the target to advance to the next Ante. The target score gets progressively higher with each Ante." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                        <VBox spacing="10.0">
                            <Label text="Hands" style="-fx-font-size: 24px; -fx-text-fill: #fca311; -fx-font-weight: bold;"/>
                            <Label text="The number of card combinations you can play per round. Playing hands scores points based on the combination of cards used." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                        <VBox spacing="10.0">
                            <Label text="Discards" style="-fx-font-size: 24px; -fx-text-fill: #fca311; -fx-font-weight: bold;"/>
                            <Label text="The number of times you can throw away up to 5 cards to draw new ones from your deck, allowing you to dig for better combinations." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>
                    </VBox>

                    <!-- ADDONS VIEW -->
                    <VBox fx:id="addonsView" visible="false" alignment="TOP_LEFT" spacing="20.0" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 15px; -fx-padding: 40px;">
                        <Label text="ADDONS &amp; ITEMS" style="-fx-font-size: 36px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        
                        <VBox spacing="10.0">
                            <Label text="Jokers" style="-fx-font-size: 24px; -fx-text-fill: #6fe3b1; -fx-font-weight: bold;"/>
                            <Label text="Passive buffs and multipliers that apply to your scored hands. You can equip up to 3 Jokers simultaneously by default to create powerful synergies." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                        <VBox spacing="10.0">
                            <Label text="Breakthroughs" style="-fx-font-size: 24px; -fx-text-fill: #6fe3b1; -fx-font-weight: bold;"/>
                            <Label text="Single-use consumables that modify your deck or grant immediate benefits. These can be used during your run to permanently alter cards." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                        <VBox spacing="10.0">
                            <Label text="Vouchers" style="-fx-font-size: 24px; -fx-text-fill: #6fe3b1; -fx-font-weight: bold;"/>
                            <Label text="Permanent upgrades that persist throughout your entire save profile across multiple runs (e.g., extra shop slots or hands). They are always active once bought." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>
                    </VBox>
                </StackPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
